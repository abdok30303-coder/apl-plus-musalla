  "body": "    <!-- Top Shelf: full-frame artwork of the selected app (2 layers for the fade) -->\n    <div id=\"bgA\" class=\"bg\"></div>\n    <div id=\"bgB\" class=\"bg\"></div>\n    <!-- Blurred grid background: a small pre-blurred image, nothing computed live -->\n    <div id=\"bgBlur\" class=\"bgblur\"></div>\n    <div class=\"scrim\"></div>\n\n    <!-- Clock card (top corner): the time, the date beside it, optionally another country's time, the avatar.\n         v1.2.50 — filled by js/home-clock.js. #clock keeps its id: it is still \"the clock\" for the rest of the code. -->\n    <div class=\"status\">\n        <div class=\"hc__cell\">\n            <span id=\"clock\" class=\"status__clock hc__time\"><span id=\"hcT\" class=\"hc__t\">9:41</span><span id=\"hcS\" class=\"hc__s\">AM</span></span>\n            <span id=\"hcLocalLabel\" class=\"hc__label\"></span>\n        </div>\n        <div id=\"hcDate\" class=\"hc__date\">\n            <span id=\"hcDow\" class=\"hc__dow\"></span>\n            <span id=\"hcGreg\" class=\"hc__greg\"></span>\n            <span id=\"hcHijri\" class=\"hc__hijri\"></span>\n        </div>\n        <div class=\"hc__cell hc__cell--other\">\n            <span class=\"hc__time hc__time--other\"><span id=\"hcT2\" class=\"hc__t\"></span><span id=\"hcS2\" class=\"hc__s\"></span></span>\n            <span id=\"hcOtherLabel\" class=\"hc__label hc__label--other\"></span>\n        </div>\n        <span class=\"status__avatar\" aria-hidden=\"true\"></span>\n    </div>\n\n    <!-- The Top Shelf film or series: title and rating -->\n    <div id=\"shelfInfo\" class=\"shelfinfo\">\n        <div id=\"shelfTitle\" class=\"shelfinfo__title\"></div>\n        <div id=\"shelfMeta\" class=\"shelfinfo__meta\"></div>\n    </div>\n\n    <!-- \"Press ▲ for full screen\" (launcher.js puts in the translated text) -->\n    <div id=\"hint\" class=\"hint\">\n        <span class=\"hint__chevron\" aria-hidden=\"true\"></span>\n        <span class=\"hint__text\">Press ▲ for full screen</span>\n    </div>\n\n    <!-- Home Screen: dock (top row) + the rows below -->\n    <main id=\"home\" class=\"home\">\n        <div class=\"dock\"><div id=\"row0\" class=\"row0\"></div></div>\n        <div id=\"rows\" class=\"rows\"></div>\n    </main>\n\n    <div id=\"toast\" class=\"toast\" aria-live=\"polite\"></div>\n    <div id=\"boot\" class=\"boot\"></div>\n\n    ",
